# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# resend.com dashboard -> API Keys
RESEND_API_KEY=re_...

# Recipient/reply-to are no longer set here -- each profile in
# profiles.json has its own "recipient_email" (see profiles.example.json).

# A real contact address for the User-Agent header on outbound feed
# requests. Some sources (e.g. SEC EDGAR) reject requests without one,
# per their fair-access policy -- they want to be able to reach whoever's
# crawling them.
DIGEST_CONTACT_EMAIL=you@example.com
