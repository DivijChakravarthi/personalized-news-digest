# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# resend.com dashboard -> API Keys
RESEND_API_KEY=re_...

# Where the digest gets sent, and where replies to it should go (usually
# the same address as DIGEST_TO).
DIGEST_TO=you@example.com
DIGEST_REPLY_TO=you@example.com

# A real contact address for the User-Agent header on outbound feed
# requests. Some sources (e.g. SEC EDGAR) reject requests without one,
# per their fair-access policy -- they want to be able to reach whoever's
# crawling them.
DIGEST_CONTACT_EMAIL=you@example.com
